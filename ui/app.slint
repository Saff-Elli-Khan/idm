import { Palette } from "std-widgets.slint";

export struct Conn {
    label: string,
    progress: float,
    detail: string,
}

export struct Row {
    id: int,
    name: string,
    ext: string,
    status: string,
    detail: string,
    progress: float,
    can-pause: bool,
    can-resume: bool,
    done: bool,
    connections: [Conn],
}

// Notion palette; follows the OS light/dark setting.
global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> bg: dark ? #191919 : #ffffff;
    out property <color> sidebar: dark ? #202020 : #f7f7f5;
    out property <color> text: dark ? #e3e3e1 : #37352f;
    out property <color> muted: dark ? #9b9a97 : #787774;
    out property <color> border: dark ? #2f2f2f : #e9e9e7;
    out property <color> hover: dark ? #2a2a2a : #efefed;
    out property <color> press: dark ? #373737 : #e3e3e1;
    out property <color> chip: dark ? #2f2f2f : #f1f1ef;
    out property <color> track: dark ? #373737 : #ebebea;
    out property <color> input: dark ? #252525 : #ffffff;
    out property <color> accent: #2383e2;
    out property <color> green: dark ? #4dab9a : #448361;
    out property <color> red: dark ? #ff7369 : #d44c47;
    out property <color> orange: dark ? #ffa344 : #cb912f;
    // Per-connection bars
    out property <color> conn: dark ? #ffa344 : #d9730d;
}

// Tabler icons (MIT), recolored with `colorize`.
component Icon inherits Image {
    in property <length> size: 18px;
    width: size;
    height: size;
}

component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    height: 30px;
    border-radius: 4px;
    background: selected || ta.pressed ? Theme.press : ta.has-hover ? Theme.hover : transparent;
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon { source: root.icon; size: 17px; colorize: root.selected ? Theme.text : Theme.muted; }
        }
        Text { text: root.label; color: Theme.text; vertical-alignment: center; font-weight: root.selected ? 600 : 400; }
    }
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <color> fg: Theme.muted;
    callback clicked;
    width: 30px;
    height: 30px;
    border-radius: 4px;
    background: ta.pressed ? Theme.press : ta.has-hover ? Theme.press.transparentize(0.3) : transparent;
    Icon { source: root.icon; colorize: root.fg; }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Minimize / maximize / close for the frameless window.
component WindowButton inherits Rectangle {
    in property <image> icon;
    in property <bool> danger;
    callback clicked;
    width: 46px;
    height: 36px;
    background: ta.has-hover ? (danger ? #e81123 : Theme.hover) : transparent;
    Icon { source: root.icon; size: 15px; colorize: root.danger && ta.has-hover ? white : Theme.muted; }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component GhostButton inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 32px;
    width: label.preferred-width + 24px;
    border-radius: 6px;
    background: ta.pressed ? Theme.press : ta.has-hover ? Theme.hover : transparent;
    label := Text {
        x: 12px;
        height: parent.height;
        text: root.text;
        color: Theme.muted;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    callback clicked;
    height: 32px;
    horizontal-stretch: 0;
    border-radius: 6px;
    background: ta.pressed ? Theme.accent.darker(0.25) : ta.has-hover ? Theme.accent.darker(0.12) : Theme.accent;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 6px;
        if root.icon.width > 0: VerticalLayout {
            alignment: center;
            Icon { source: root.icon; size: 16px; colorize: white; }
        }
        Text { text: root.text; color: white; font-weight: 600; vertical-alignment: center; }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Input inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> ti.text;
    callback accepted(string);
    public function focus-input() { ti.focus(); }
    height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: ti.has-focus ? Theme.accent : Theme.border;
    background: Theme.input;
    ti := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        color: Theme.text;
        vertical-alignment: center;
        accepted => { root.accepted(self.text); }
    }
    if ti.text == "": Text {
        x: 10px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.muted;
        vertical-alignment: center;
    }
}

component Toggle inherits Rectangle {
    in property <bool> checked;
    callback toggled(bool);
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: root.checked ? Theme.accent : Theme.press;
    animate background { duration: 120ms; }
    Rectangle {
        x: root.checked ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: white;
        animate x { duration: 120ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

component RowView inherits Rectangle {
    in property <Row> item;
    callback pause();
    callback resume();
    callback remove();
    callback open();
    // Notion "select" tag colors
    property <color> tone: root.item.status == "Downloading" ? Theme.accent
        : root.item.status == "Completed" ? Theme.green
        : root.item.status == "Failed" ? Theme.red
        : root.item.status == "Paused" ? Theme.orange : Theme.muted;
    // Click a row to see the file map and each connection.
    property <bool> expanded;
    height: 62px + (root.expanded ? details.preferred-height : 0px);
    border-radius: 6px;
    background: ta.has-hover || root.expanded ? Theme.hover : transparent;
    ta := TouchArea {
      mouse-cursor: pointer;
      clicked => { root.expanded = !root.expanded; }
      VerticalLayout {
        HorizontalLayout {
            height: 62px;
            padding-left: 10px;
            padding-right: 10px;
            spacing: 14px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 6px;
                    background: Theme.chip;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.item.ext;
                        color: Theme.muted;
                        font-size: 9px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 7px;
                Text { text: root.item.name; color: Theme.text; font-weight: 500; overflow: elide; }
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 160px;
                            height: 4px;
                            border-radius: 2px;
                            background: Theme.track;
                            Rectangle {
                                x: 0;
                                width: parent.width * root.item.progress;
                                height: parent.height;
                                border-radius: 2px;
                                background: root.tone;
                            }
                        }
                    }
                    Text { text: root.item.detail; color: Theme.muted; font-size: 12px; overflow: elide; }
                }
            }
            // The status tag and the hover actions share one slot, like Notion's row handles.
            Rectangle {
                width: 120px;
                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    visible: !ta.has-hover;
                    HorizontalLayout {
                        alignment: end;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: tag.preferred-width + 16px;
                                height: 22px;
                                border-radius: 4px;
                                background: root.tone.transparentize(0.84);
                                tag := Text {
                                    x: 8px;
                                    height: parent.height;
                                    text: root.item.status;
                                    color: root.tone;
                                    font-size: 12px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    visible: ta.has-hover;
                    HorizontalLayout {
                        alignment: end;
                        spacing: 2px;
                        VerticalLayout {
                            alignment: center;
                            if root.item.can-pause: IconButton { icon: @image-url("icons/player-pause.svg"); clicked => { root.pause(); } }
                            if root.item.can-resume: IconButton { icon: @image-url("icons/player-play.svg"); clicked => { root.resume(); } }
                            if root.item.done: IconButton { icon: @image-url("icons/folder-open.svg"); clicked => { root.open(); } }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton { icon: @image-url("icons/trash.svg"); fg: Theme.red; clicked => { root.remove(); } }
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Icon {
                    source: @image-url("icons/chevron-down.svg");
                    size: 16px;
                    colorize: Theme.muted;
                    transform-rotation: root.expanded ? 180deg : 0deg;
                }
            }
        }
        details := Rectangle {
            visible: root.expanded;
            VerticalLayout {
                padding-left: 60px;
                padding-right: 40px;
                padding-bottom: 16px;
                spacing: 8px;
                for c in root.item.connections: HorizontalLayout {
                    spacing: 12px;
                    Text { width: 112px; text: c.label; color: Theme.muted; font-size: 12px; vertical-alignment: center; overflow: elide; }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 160px;
                            height: 4px;
                            border-radius: 2px;
                            background: Theme.track;
                            Rectangle {
                                x: 0;
                                width: parent.width * c.progress;
                                height: parent.height;
                                border-radius: 2px;
                                background: Theme.conn;
                            }
                        }
                    }
                    Text { text: c.detail; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                }
                if root.item.connections.length == 0: Text {
                    text: root.item.status == "Downloading" ? "Connecting…" : "No active connections";
                    color: Theme.muted;
                    font-size: 12px;
                }
            }
        }
      }
    }
}

// One line of the settings page: icon, title and description on the left, control on the right.
component SettingRow inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> description;
    HorizontalLayout {
        padding-top: 18px;
        padding-bottom: 18px;
        spacing: 14px;
        VerticalLayout {
            padding-top: 2px;
            Icon { source: root.icon; size: 18px; colorize: Theme.muted; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            Text { text: root.title; color: Theme.text; font-weight: 600; }
            Text { text: root.description; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

export component AppWindow inherits Window {
    in property <[Row]> rows;
    in property <string> summary;
    in property <string> browser-status;
    in-out property <int> filter; // 0 all, 1 in progress, 2 completed
    callback add(string);
    callback pause(int);
    callback resume(int);
    callback remove(int);
    callback open(int);
    callback set-limit(string);
    in-out property <string> limit-text;
    in-out property <int> conns: 8;
    callback set-conns(int);
    callback register-handlers() -> string;
    in-out property <bool> autostart;
    callback set-autostart(bool);
    property <string> handler-status;
    callback refresh();
    callback drag(length, length);
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    property <bool> adding;

    no-frame: true;
    title: "IDM2";
    icon: @image-url("logo.svg");
    preferred-width: 1040px;
    preferred-height: 660px;
    min-width: 760px;
    min-height: 420px;
    background: Theme.bg;
    default-font-family: "Segoe UI";
    default-font-size: 14px;

    HorizontalLayout {
        Rectangle {
            width: 236px;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 10px;
                padding-top: 14px;
                spacing: 2px;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-bottom: 16px;
                    spacing: 10px;
                    Image { source: @image-url("logo.svg"); width: 24px; height: 24px; }
                    Text { text: "IDM2"; color: Theme.text; font-weight: 600; vertical-alignment: center; }
                }
                NavItem {
                    icon: @image-url("icons/list.svg");
                    label: "All downloads";
                    selected: root.filter == 0;
                    clicked => { root.filter = 0; root.refresh(); }
                }
                NavItem {
                    icon: @image-url("icons/progress-down.svg");
                    label: "In progress";
                    selected: root.filter == 1;
                    clicked => { root.filter = 1; root.refresh(); }
                }
                NavItem {
                    icon: @image-url("icons/circle-check.svg");
                    label: "Completed";
                    selected: root.filter == 2;
                    clicked => { root.filter = 2; root.refresh(); }
                }
                Rectangle { vertical-stretch: 1; }
                NavItem {
                    icon: @image-url("icons/settings.svg");
                    label: "Settings";
                    selected: root.filter == 3;
                    clicked => { root.filter = 3; }
                }
            }
        }
        Rectangle { width: 1px; background: Theme.border; }
        VerticalLayout {
            padding-left: 56px;
            padding-right: 56px;
            padding-top: 44px;
            HorizontalLayout {
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;
                    Text {
                        text: root.filter == 0 ? "All downloads" : root.filter == 1 ? "In progress" : root.filter == 2 ? "Completed" : "Settings";
                        color: Theme.text;
                        font-size: 32px;
                        font-weight: 700;
                    }
                    Text { text: root.filter == 3 ? "Changes are saved automatically." : root.summary; color: Theme.muted; }
                }
                if root.filter != 3: VerticalLayout {
                    alignment: start;
                    PrimaryButton {
                        icon: @image-url("icons/plus.svg");
                        text: "New download";
                        clicked => { root.adding = true; }
                    }
                }
            }
            Rectangle { height: 24px; }
            Rectangle { height: 1px; background: Theme.border; }
            Rectangle { height: 8px; }
            if root.filter == 3: VerticalLayout {
                vertical-stretch: 1;
                alignment: start;
                SettingRow {
                    icon: @image-url("icons/power.svg");
                    title: "Start with Windows";
                    description: "IDM2 starts quietly in the tray when you sign in, so queued downloads resume and browser downloads are caught right away.";
                    Toggle {
                        checked: root.autostart;
                        toggled(on) => { root.set-autostart(on); }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                SettingRow {
                    icon: @image-url("icons/network.svg");
                    title: "Connections per download";
                    description: "More connections are usually faster. Some servers limit how many they accept. Applies to running downloads too.";
                    Rectangle {
                        width: 140px;
                        height: 32px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.border;
                        background: Theme.input;
                        HorizontalLayout {
                            padding: 1px;
                            IconButton { icon: @image-url("icons/minus.svg"); clicked => { root.set-conns(root.conns - 1); } }
                            Text {
                                horizontal-stretch: 1;
                                text: root.conns;
                                color: Theme.text;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            IconButton { icon: @image-url("icons/plus.svg"); clicked => { root.set-conns(root.conns + 1); } }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                SettingRow {
                    icon: @image-url("icons/gauge.svg");
                    title: "Speed limit";
                    description: "Shared by all downloads. Leave empty for unlimited, press Enter to apply.";
                    HorizontalLayout {
                        spacing: 8px;
                        Input {
                            width: 140px;
                            placeholder: "Unlimited";
                            text <=> root.limit-text;
                            accepted(t) => { root.set-limit(t); }
                        }
                        Text { text: "MB/s"; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                SettingRow {
                    icon: @image-url("icons/plug-connected.svg");
                    title: "Browser integration";
                    description: "Load the extension folder in Chrome, Edge or Firefox to send browser downloads here.";
                    Text { text: root.browser-status; color: Theme.muted; font-size: 13px; vertical-alignment: center; }
                }
                Rectangle { height: 1px; background: Theme.border; }
                SettingRow {
                    icon: @image-url("icons/magnet.svg");
                    title: "Magnet links and .torrent files";
                    description: root.handler-status != "" ? root.handler-status
                        : "Open them with IDM2 from your browser and File Explorer. This replaces any other torrent app for your Windows account.";
                    PrimaryButton {
                        text: "Use IDM2";
                        clicked => { root.handler-status = root.register-handlers(); }
                    }
                }
            }
            if root.filter != 3: Flickable {
                vertical-stretch: 1;
                content-height: list.preferred-height;
                list := VerticalLayout {
                    alignment: start;
                    spacing: 2px;
                    for r in root.rows: RowView {
                        item: r;
                        pause => { root.pause(r.id); }
                        resume => { root.resume(r.id); }
                        remove => { root.remove(r.id); }
                        open => { root.open(r.id); }
                    }
                    if root.rows.length == 0: VerticalLayout {
                        padding-top: 80px;
                        spacing: 12px;
                        alignment: start;
                        HorizontalLayout {
                            alignment: center;
                            Icon { source: @image-url("icons/cloud-download.svg"); size: 40px; colorize: Theme.muted.transparentize(0.4); }
                        }
                        Text {
                            text: "Nothing here yet";
                            color: Theme.text;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Click New download, or download something in your browser.";
                            color: Theme.muted;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // Frameless window: the top strip moves the window, double-click maximizes.
    TouchArea {
        x: 0;
        y: 0;
        width: root.width - 138px;
        height: 40px;
        moved => { root.drag(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); }
        double-clicked => { root.toggle-maximize(); }
    }
    HorizontalLayout {
        x: root.width - 138px;
        y: 0;
        width: 138px;
        height: 36px;
        WindowButton { icon: @image-url("icons/minus.svg"); clicked => { root.minimize(); } }
        WindowButton { icon: @image-url("icons/square.svg"); clicked => { root.toggle-maximize(); } }
        WindowButton { icon: @image-url("icons/x.svg"); danger: true; clicked => { root.close-window(); } }
    }

    if root.adding: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #00000059;
        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.adding = false; }
        }
        Rectangle {
            width: 520px;
            height: 154px;
            border-radius: 10px;
            background: Theme.bg;
            drop-shadow-blur: 28px;
            drop-shadow-offset-y: 10px;
            drop-shadow-color: #00000040;
            TouchArea {
                width: parent.width;
                height: parent.height;
            } // swallow clicks so they don't close the dialog
            VerticalLayout {
                padding: 20px;
                spacing: 14px;
                HorizontalLayout {
                    Text { text: "New download"; color: Theme.text; font-size: 16px; font-weight: 600; vertical-alignment: center; }
                    IconButton { icon: @image-url("icons/x.svg"); clicked => { root.adding = false; } }
                }
                url := Input {
                    placeholder: "Paste a link, magnet link or .torrent file path…";
                    accepted(t) => { root.add(t); root.adding = false; }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    GhostButton { text: "Cancel"; clicked => { root.adding = false; } }
                    PrimaryButton { text: "Download"; clicked => { root.add(url.text); root.adding = false; } }
                }
            }
            init => { url.focus-input(); }
        }
    }
}
